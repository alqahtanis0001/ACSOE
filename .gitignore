# Secrets — never commit
.env
.env.*
!.env.example
config/LIVE_CONFIRMED
*.key
credentials*

# Data — large, regenerable, and potentially revealing of account activity
data/raw/
data/derived/
data/historical/
data/db/

# Recording Manager runtime output. `*.jsonl` below covers the archive files it
# moves around; these three do not contain only archive files. `data/nodes/`
# holds built node packages - real .py, .bat and .sh copied out of the tree for
# somebody to carry to another machine - and committing those would put a second,
# silently diverging copy of the recorder in the repository.
data/staging/
data/inbox/
data/nodes/
scripts/recording/.coverage-cache.json

# The live source registry. It accumulates the hostnames and addresses of real
# machines - some of them not ours - and this repository is public. The committed
# file is sources.example.yaml; copy it to sources.yaml on a machine that runs the
# manager, and that copy stays local.
scripts/recording/sources.yaml
*.sqlite
*.sqlite-journal
*.parquet
*.jsonl

# ...but verify.py's evidence MUST be committable. This negation is load-bearing:
# without it every offline criterion silently fails the fresh-clone rule.
!tests/fixtures/**

# Trained artefacts
models/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent config — project settings.json IS committed, local overrides are not
.claude/settings.local.json

# Logs
logs/

# Word and Excel leave these behind whenever a document is open. They are
# never content, and one committed once is a merge conflict nobody can read.
~$*
