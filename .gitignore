# Secrets — never commit
.env
.env.*
!.env.example
config/LIVE_CONFIRMED
*.key
credentials*

# Data — large, regenerable, and potentially revealing of account activity
data/raw/
data/derived/
data/historical/
data/db/
*.sqlite
*.sqlite-journal
*.parquet
*.jsonl

# ...but verify.py's evidence MUST be committable. This negation is load-bearing:
# without it every offline criterion silently fails the fresh-clone rule.
!tests/fixtures/**

# Trained artefacts
models/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agent config — project settings.json IS committed, local overrides are not
.claude/settings.local.json

# Logs
logs/
