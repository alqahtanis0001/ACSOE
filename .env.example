# Copy to .env and fill in. .env is gitignored and must never be committed.

# Kraken API. Use a READ-ONLY key until Phase 8.
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Live trading switch 1 of 3. Leave unset or 0 for paper mode.
# The other two are `mode: live` in config and a dated config/LIVE_CONFIRMED file.
ACSOE_LIVE=0
